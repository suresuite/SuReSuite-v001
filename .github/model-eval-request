# Git-native trigger for .github/workflows/ai-agent-model-eval.yml — the §7.4
# model-scored eval tier + live deployment-state capture. Exists for
# environments that can push but cannot call the Actions API (the
# ops-request/seed-request idiom). Change any line and push to fire a run;
# results land on the eval-results branch (results/latest.log).
#
#   agents=<comma list>       which agents to score (§7.4: every enabled agent)
#   models=<comma list>       which models to score (empty = gpt-5)
#   mode=full|state-only      state-only skips the two eval tiers
run=12 §25 Q3 diagnostic — observed replies/proposals on failed fixtures; owner defaults (38(s)); gpt-5 only (2026-11-07)
agents=data-steward,policy-configurator,vv-analyst,experiment-designer,report-builder
models=gpt-5
mode=full
